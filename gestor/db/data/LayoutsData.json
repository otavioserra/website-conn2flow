        "nome": "Layout Principal — Curso de IA",
        "id": "layout-principal",
        "language": "pt-br",
        "html": "<!DOCTYPE html>\n<html lang=\"pt-br\" class=\"scroll-smooth\">\n\n<head>\n    <!-- pagina#titulo -->\n    <meta http-equiv=\"Content-Type\" content=\"text\/html; charset=UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <meta name=\"description\" content=\"Trabalhando em Par com IA — Do Zero ao Avançado: Planejar, Construir e Dominar Projetos Reais com Agentes de IA. Série gratuita no YouTube com materiais no GitHub.\">\n    <meta name=\"theme-color\" content=\"#060e0a\">\n    <meta property=\"og:type\" content=\"website\">\n    <meta property=\"og:title\" content=\"Trabalhando em Par com IA — Curso de IA | Conn2Flow\">\n    <meta property=\"og:description\" content=\"Aprenda a transformar o seu computador em uma empresa de automação de 1 pessoa só com Agentes de IA, Antigravity 2.0 e Governança SDD.\">\n    <link rel=\"apple-touch-icon\" sizes=\"180x180\" href=\"@[[pagina#url-raiz]]@favicon\/apple-touch-icon.png\">\n    <link rel=\"icon\" type=\"image\/png\" sizes=\"32x32\" href=\"@[[pagina#url-raiz]]@favicon\/favicon-32x32.png\">\n    <link rel=\"icon\" type=\"image\/png\" sizes=\"16x16\" href=\"@[[pagina#url-raiz]]@favicon\/favicon-16x16.png\">\n    <link rel=\"manifest\" href=\"@[[pagina#url-raiz]]@favicon\/site.webmanifest\">\n\n    <!-- Tipografia global: Nunito (Google Fonts) -->\n    <link rel=\"preconnect\" href=\"https:\/\/fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https:\/\/fonts.gstatic.com\" crossorigin>\n    <link href=\"https:\/\/fonts.googleapis.com\/css2?family=Nunito:ital,wght@0,300;0,400;0,600;0,700;0,800;0,900;1,400;1,700&display=swap\" rel=\"stylesheet\">\n\n    <!-- pagina#css -->\n    <!-- pagina#js -->\n\n    <!--\n        Tailwind CSS v4 em runtime (fallback de autoria). O CSS derivado oficial e gerado pelo pipeline\n        (c2f resources:sync + c2f css:rebuild) e injetado no marcador pagina#css acima. O script abaixo garante\n        renderizacao fiel em pre-visualizacoes locais e em ambientes ainda sem css_compiled no banco.\n    -->\n    <script src=\"https:\/\/cdn.jsdelivr.net\/npm\/@tailwindcss\/browser@4\"><\/script>\n    <style type=\"text\/tailwindcss\">\n        @theme {\n            --font-sans: 'Nunito', ui-sans-serif, system-ui, sans-serif;\n            --color-abyss: #060e0a;\n            --color-deep: #0a1510;\n            --color-forest: #0f1f17;\n        }\n    <\/style>\n<\/head>\n\n<body class=\"min-h-screen bg-[#060e0a] text-slate-200 antialiased selection:bg-emerald-500 selection:text-[#060e0a]\">\n\n    <!-- Camada de fundo global: grade tecnológica + glows esmeralda -->\n    <div aria-hidden=\"true\" class=\"pointer-events-none fixed inset-0 z-0 overflow-hidden\">\n        <div class=\"absolute inset-0 c2f-grid opacity-[0.35]\"><\/div>\n        <div class=\"absolute -top-40 left-1\/4 h-[28rem] w-[28rem] rounded-full bg-emerald-500\/15 blur-3xl animate-pulse\"><\/div>\n        <div class=\"absolute top-1\/3 -right-40 h-[26rem] w-[26rem] rounded-full bg-emerald-400\/10 blur-3xl c2f-float\"><\/div>\n        <div class=\"absolute -bottom-40 left-[-10%] h-[30rem] w-[30rem] rounded-full bg-teal-500\/10 blur-3xl animate-pulse [animation-delay:1.5s]\"><\/div>\n    <\/div>\n\n    <!-- Barra de progresso de leitura -->\n    <div id=\"c2f-progress\" aria-hidden=\"true\" class=\"fixed left-0 top-0 z-[60] h-[3px] w-0 bg-gradient-to-r from-emerald-500 via-emerald-300 to-emerald-500 shadow-[0_0_12px_rgba(52,211,153,0.8)] transition-[width] duration-150\"><\/div>\n\n    <!-- ===== Cabeçalho \/ Navbar ===== -->\n    <header id=\"c2f-header\" class=\"fixed inset-x-0 top-0 z-50 border-b border-transparent transition-all duration-300\">\n        <nav class=\"mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-4 sm:px-6 lg:px-8\" aria-label=\"Navegação principal\">\n            <!-- Logo + tag do curso -->\n            <a href=\"@[[pagina#url-raiz]]@\" class=\"group flex items-center gap-3\">\n                <span class=\"relative flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-emerald-400 to-emerald-600 text-[#060e0a] shadow-[0_0_24px_rgba(16,185,129,0.45)] transition-transform duration-300 group-hover:scale-105 group-hover:rotate-3\">\n                    <svg viewBox=\"0 0 24 24\" class=\"h-6 w-6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 12a8 8 0 0 1 8-8\"\/><path d=\"M20 12a8 8 0 0 1-8 8\"\/><circle cx=\"12\" cy=\"12\" r=\"2.5\"\/><path d=\"M4 12h3M17 12h3\"\/><\/svg>\n                <\/span>\n                <span class=\"flex flex-col leading-none\">\n                    <span class=\"text-lg font-extrabold tracking-tight text-white\">Conn2Flow<\/span>\n                    <span class=\"mt-1 inline-flex w-fit items-center gap-1 rounded-full border border-emerald-500\/30 bg-emerald-500\/10 px-2 py-[2px] text-[10px] font-bold uppercase tracking-widest text-emerald-300\">\n                        <span class=\"h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse\"><\/span>Curso de IA\n                    <\/span>\n                <\/span>\n            <\/a>\n\n            <!-- Menu desktop -->\n            <ul class=\"hidden items-center gap-1 lg:flex\">\n                <li><a href=\"#episodios\" class=\"c2f-navlink\">Episódios<\/a><\/li>\n                <li><a href=\"#metodologia\" class=\"c2f-navlink\">Metodologia<\/a><\/li>\n                <li><a href=\"#materiais\" class=\"c2f-navlink\">Materiais<\/a><\/li>\n                <li><a href=\"#stack\" class=\"c2f-navlink\">Stack<\/a><\/li>\n                <li><a href=\"#faq\" class=\"c2f-navlink\">FAQ<\/a><\/li>\n            <\/ul>\n\n            <!-- CTAs desktop -->\n            <div class=\"hidden items-center gap-3 lg:flex\">\n                <a href=\"https:\/\/github.com\/otavioserra\/conn2flow-ai-workspace\" target=\"_blank\" rel=\"noopener\" class=\"inline-flex items-center gap-2 rounded-full border border-white\/10 bg-white\/5 px-4 py-2 text-sm font-bold text-slate-200 transition-all duration-300 hover:border-emerald-500\/40 hover:bg-white\/10 hover:text-white\">\n                    <svg viewBox=\"0 0 24 24\" class=\"h-4 w-4\" fill=\"currentColor\"><path d=\"M12 .5C5.7.5.7 5.5.7 11.8c0 5 3.2 9.2 7.7 10.7.6.1.8-.2.8-.5v-2c-3.1.7-3.8-1.3-3.8-1.3-.5-1.3-1.2-1.7-1.2-1.7-1-.7.1-.7.1-.7 1.1.1 1.7 1.2 1.7 1.2 1 1.7 2.6 1.2 3.3.9.1-.7.4-1.2.7-1.5-2.5-.3-5.1-1.3-5.1-5.6 0-1.2.4-2.3 1.2-3-.1-.3-.5-1.5.1-3 0 0 1-.3 3.1 1.2a10.7 10.7 0 0 1 5.7 0c2.2-1.5 3.1-1.2 3.1-1.2.6 1.5.2 2.7.1 3 .8.8 1.2 1.8 1.2 3 0 4.3-2.6 5.3-5.1 5.6.4.4.8 1.1.8 2.1v3.2c0 .3.2.7.8.5 4.5-1.5 7.7-5.7 7.7-10.7C23.3 5.5 18.3.5 12 .5z\"\/><\/svg>\n                    GitHub\n                <\/a>\n                <a href=\"https:\/\/www.youtube.com\/playlist?list=PLBjofG88X62Y\" target=\"_blank\" rel=\"noopener\" class=\"c2f-btn-glow inline-flex items-center gap-2 rounded-full bg-emerald-500 px-5 py-2 text-sm font-extrabold text-[#060e0a] transition-all duration-300 hover:bg-emerald-400 hover:shadow-[0_0_28px_rgba(52,211,153,0.6)]\">\n                    <svg viewBox=\"0 0 24 24\" class=\"h-4 w-4\" fill=\"currentColor\"><path d=\"M8 5v14l11-7z\"\/><\/svg>\n                    Assistir Grátis\n                <\/a>\n            <\/div>\n\n            <!-- Botão hamburguer (mobile) -->\n            <button type=\"button\" id=\"c2f-menu-toggle\" aria-controls=\"c2f-mobile-menu\" aria-expanded=\"false\" aria-label=\"Abrir menu\" class=\"inline-flex h-11 w-11 items-center justify-center rounded-xl border border-white\/10 bg-white\/5 text-slate-200 transition-colors hover:border-emerald-500\/40 hover:text-white lg:hidden\">\n                <svg data-icon=\"open\" viewBox=\"0 0 24 24\" class=\"h-6 w-6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M4 7h16M4 12h16M4 17h16\"\/><\/svg>\n                <svg data-icon=\"close\" viewBox=\"0 0 24 24\" class=\"hidden h-6 w-6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M6 6l12 12M18 6L6 18\"\/><\/svg>\n            <\/button>\n        <\/nav>\n\n        <!-- Menu mobile -->\n        <div id=\"c2f-mobile-menu\" class=\"hidden border-t border-emerald-500\/10 bg-[#060e0a]\/95 backdrop-blur-xl lg:hidden\">\n            <div class=\"mx-auto flex max-w-7xl flex-col gap-1 px-4 py-4 sm:px-6\">\n                <a href=\"#episodios\" class=\"c2f-navlink-mobile\">Episódios<\/a>\n                <a href=\"#metodologia\" class=\"c2f-navlink-mobile\">Metodologia<\/a>\n                <a href=\"#materiais\" class=\"c2f-navlink-mobile\">Materiais<\/a>\n                <a href=\"#stack\" class=\"c2f-navlink-mobile\">Stack<\/a>\n                <a href=\"#faq\" class=\"c2f-navlink-mobile\">FAQ<\/a>\n                <div class=\"mt-3 grid grid-cols-2 gap-3\">\n                    <a href=\"https:\/\/github.com\/otavioserra\/conn2flow-ai-workspace\" target=\"_blank\" rel=\"noopener\" class=\"inline-flex items-center justify-center gap-2 rounded-xl border border-white\/10 bg-white\/5 px-4 py-3 text-sm font-bold text-slate-200\">GitHub<\/a>\n                    <a href=\"https:\/\/www.youtube.com\/playlist?list=PLBjofG88X62Y\" target=\"_blank\" rel=\"noopener\" class=\"inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-500 px-4 py-3 text-sm font-extrabold text-[#060e0a]\">Assistir Grátis<\/a>\n                <\/div>\n            <\/div>\n        <\/div>\n    <\/header>\n\n    <!-- ===== Slot de conteúdo da página ===== -->\n    <main id=\"conteudo\" class=\"relative z-10\">\n        @[[pagina#corpo]]@\n    <\/main>\n\n    <!-- ===== Rodapé ===== -->\n    <footer class=\"relative z-10 border-t border-emerald-500\/10 bg-gradient-to-b from-[#0a1510] to-black\">\n        <div class=\"pointer-events-none absolute inset-x-0 top-0 mx-auto h-px w-2\/3 bg-gradient-to-r from-transparent via-emerald-400\/60 to-transparent\"><\/div>\n       