orkspace\" target=\"_blank\" rel=\"noopener\" aria-label=\"GitHub\" class=\"c2f-social\"><svg viewBox=\"0 0 24 24\" class=\"h-5 w-5\" fill=\"currentColor\"><path d=\"M12 .5C5.7.5.7 5.5.7 11.8c0 5 3.2 9.2 7.7 10.7.6.1.8-.2.8-.5v-2c-3.1.7-3.8-1.3-3.8-1.3-.5-1.3-1.2-1.7-1.2-1.7-1-.7.1-.7.1-.7 1.1.1 1.7 1.2 1.7 1.2 1 1.7 2.6 1.2 3.3.9.1-.7.4-1.2.7-1.5-2.5-.3-5.1-1.3-5.1-5.6 0-1.2.4-2.3 1.2-3-.1-.3-.5-1.5.1-3 0 0 1-.3 3.1 1.2a10.7 10.7 0 0 1 5.7 0c2.2-1.5 3.1-1.2 3.1-1.2.6 1.5.2 2.7.1 3 .8.8 1.2 1.8 1.2 3 0 4.3-2.6 5.3-5.1 5.6.4.4.8 1.1.8 2.1v3.2c0 .3.2.7.8.5 4.5-1.5 7.7-5.7 7.7-10.7C23.3 5.5 18.3.5 12 .5z\"\/><\/svg><\/a>\n                        <a href=\"https:\/\/www.linkedin.com\/company\/conn2flow\" target=\"_blank\" rel=\"noopener\" aria-label=\"LinkedIn\" class=\"c2f-social\"><svg viewBox=\"0 0 24 24\" class=\"h-5 w-5\" fill=\"currentColor\"><path d=\"M20.4 20.5h-3.6v-5.6c0-1.3 0-3-1.8-3s-2.1 1.4-2.1 2.9v5.7H9.3V9h3.4v1.6h.1a3.7 3.7 0 0 1 3.4-1.9c3.6 0 4.3 2.4 4.3 5.5v6.3zM5.3 7.4a2.1 2.1 0 1 1 0-4.2 2.1 2.1 0 0 1 0 4.2zM7.1 20.5H3.5V9h3.6v11.5zM22.2 0H1.8C.8 0 0 .8 0 1.7v20.5c0 1 .8 1.8 1.8 1.8h20.4c1 0 1.8-.8 1.8-1.8V1.7C24 .8 23.2 0 22.2 0z\"\/><\/svg><\/a>\n                        <a href=\"https:\/\/x.com\/conn2flow\" target=\"_blank\" rel=\"noopener\" aria-label=\"X\" class=\"c2f-social\"><svg viewBox=\"0 0 24 24\" class=\"h-5 w-5\" fill=\"currentColor\"><path d=\"M18.2 2h3.4l-7.4 8.5L23 22h-6.8l-5.3-7-6.1 7H1.4l7.9-9.1L1 2h7l4.8 6.4L18.2 2zm-1.2 18h1.9L7.1 3.9h-2L17 20z\"\/><\/svg><\/a>\n                    <\/div>\n                <\/div>\n\n                <!-- Colunas de links -->\n                <div class=\"lg:col-span-2\">\n                    <h3 class=\"c2f-footer-title\">Curso<\/h3>\n                    <ul class=\"mt-4 space-y-3\">\n                        <li><a href=\"#episodios\" class=\"c2f-footer-link\">Episódios<\/a><\/li>\n                        <li><a href=\"#metodologia\" class=\"c2f-footer-link\">Metodologia<\/a><\/li>\n                        <li><a href=\"#materiais\" class=\"c2f-footer-link\">Materiais<\/a><\/li>\n                        <li><a href=\"#stack\" class=\"c2f-footer-link\">Stack<\/a><\/li>\n                        <li><a href=\"#faq\" class=\"c2f-footer-link\">FAQ<\/a><\/li>\n                    <\/ul>\n                <\/div>\n                <div class=\"lg:col-span-2\">\n                    <h3 class=\"c2f-footer-title\">Recursos<\/h3>\n                    <ul class=\"mt-4 space-y-3\">\n                        <li><a href=\"https:\/\/www.youtube.com\/playlist?list=PLBjofG88X62Y\" target=\"_blank\" rel=\"noopener\" class=\"c2f-footer-link\">Playlist Oficial<\/a><\/li>\n                        <li><a href=\"https:\/\/github.com\/otavioserra\/conn2flow-ai-workspace\" target=\"_blank\" rel=\"noopener\" class=\"c2f-footer-link\">Repositório GitHub<\/a><\/li>\n                        <li><a href=\"https:\/\/github.com\/otavioserra\/conn2flow\" target=\"_blank\" rel=\"noopener\" class=\"c2f-footer-link\">Conn2Flow Open Source<\/a><\/li>\n                        <li><a href=\"https:\/\/conn2flow.com\/changelog\/\" target=\"_blank\" rel=\"noopener\" class=\"c2f-footer-link\">Changelog<\/a><\/li>\n                    <\/ul>\n                <\/div>\n                <div class=\"lg:col-span-2\">\n                    <h3 class=\"c2f-footer-title\">Conn2Flow<\/h3>\n                    <ul class=\"mt-4 space-y-3\">\n                        <li><a href=\"https:\/\/conn2flow.com\/\" target=\"_blank\" rel=\"noopener\" class=\"c2f-footer-link\">Site Oficial<\/a><\/li>\n                        <li><a href=\"https:\/\/conn2flow.com\/pro\/#planos\" target=\"_blank\" rel=\"noopener\" class=\"c2f-footer-link\">Conn2Flow Pro<\/a><\/li>\n                        <li><a href=\"https:\/\/conn2flow.com\/pro\/\" target=\"_blank\" rel=\"noopener\" class=\"c2f-footer-link\">Filosofia<\/a><\/li>\n                        <li><a href=\"https:\/\/conn2flow.com\/contact\/\" target=\"_blank\" rel=\"noopener\" class=\"c2f-footer-link\">Contato<\/a><\/li>\n                    <\/ul>\n                <\/div>\n\n                <!-- Status da série -->\n                <div class=\"lg:col-span-2\">\n                    <h3 class=\"c2f-footer-title\">Status<\/h3>\n                    <div class=\"mt-4 rounded-2xl border border-emerald-500\/20 bg-emerald-500\/5 p-4\">\n                        <div class=\"flex items-center gap-2 text-sm font-bold text-emerald-300\">\n                            <span class=\"relative flex h-2.5 w-2.5\"><span class=\"absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75\"><\/span><span class=\"relative inline-flex h-2.5 w-2.5 rounded-full bg-emerald-400\"><\/span><\/span>\n                            Série em produção\n                        <\/div>\n                        <p class=\"mt-2 text-xs leading-relaxed text-slate-400\">Novos episódios publicados continuamente. Ative o sino na playlist.<\/p>\n                    <\/div>\n                <\/div>\n            <\/div>\n\n            <div class=\"mt-14 flex flex-col items-center justify-between gap-4 border-t border-white\/5 pt-8 text-xs text-slate-500 sm:flex-row\">\n                <p>© 2026 Conn2Flow. Infraestrutura Open Source. Todos os direitos reservados.<\/p>\n                <p class=\"flex items-center gap-2\">Powered by <a href=\"https:\/\/conn2flow.com\/\" target=\"_blank\" rel=\"noopener\" class=\"font-bold text-emerald-400 transition-colors hover:text-emerald-300\">Conn2Flow Pro<\/a><span class=\"text-slate-600\">·<\/span>Core Codeflow<\/p>\n            <\/div>\n        <\/div>\n    <\/footer>\n\n    <!-- Voltar ao topo -->\n    <a href=\"#\" id=\"c2f-backtop\" aria-label=\"Voltar ao topo\" class=\"fixed bottom-6 right-6 z-50 flex h-11 w-11 translate-y-20 items-center justify-center rounded-full border border-emerald-500\/40 bg-[#0a1510]\/90 text-emerald-300 opacity-0 shadow-[0_0_20px_rgba(16,185,129,0.35)] backdrop-blur transition-all duration-300 hover:bg-emerald-500 hover:text-[#060e0a]\">\n        <svg viewBox=\"0 0 24 24\" class=\"h-5 w-5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 19V5M5 12l7-7 7 7\"\/><\/svg>\n    <\/a>\n\n    <div id=\"gestor-listener\"><\/div>\n\n    <script>\n        (function () {\n            var header = document.getElementById('c2f-header');\n            var toggle = document.getElementById('c2f-menu-toggle');\n            var menu = document.getElementById('c2f-mobile-menu');\n            var progress = document.getElementById('c2f-progress');\n            var backtop = document.getElementById('c2f-backtop');\n\n            function onScroll() {\n                var y = window.scrollY || document.documentElement.scrollTop;\n                if (header) header.classList.toggle('c2f-header-scrolled', y > 24);\n                if (progress) {\n                    var max = document.documentElement.scrollHeight - window.innerHeight;\n                    progress.style.width = (max > 0 ? Math.min(100, (y \/ max) * 100) : 0) + '%';\n                }\n                if (backtop) {\n                    var show = y > 600;\n                    backtop.classList.toggle('opacity-0', !show);\n                    backtop.classList.toggle('translate-y-20', !show);\n                }\n            }\n            window.addEventListener('scroll', onScroll, { passive: true });\n            onScroll();\n\n            if (toggle && menu) {\n                toggle.addEventListener('click', function () {\n                    var open = menu.classList.toggle('hidden') === false;\n                    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');\n                    toggle.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu');\n                    toggle.querySelector('[data-icon=\"open\"]').classList.toggle('hidden', open);\n                    toggle.querySelector('[data-icon=\"close\"]').classList.toggle('hidden', !open);\n                });\n                menu.querySelectorAll('a[href^=\"#\"]').forEach(function (a) {\n                    a.addEventListener('click', function () { toggle.click(); });\n                });\n            }\n\n            \/\/ Revelação progressiva de elementos ao entrar na viewport\n            if ('IntersectionObserver' in window) {\n                var io = new IntersectionObserver(function (entries) {\n                    entries.forEach(function (e) {\n                        if (e.isIntersecting) { e.target.classList.add('c2f-revealed'); io.unobserve(e.target); }\n                    });\n                }, { threshold: 0.12 });\n                document.querySelectorAll('.c2f-reveal').forEach(function (el) { io.observe(el); });\n            } else {\n                document.querySelectorAll('.c2f-reveal').forEach(function (el) { el.classList.add('c2f-revealed'); });\n            }\n        })();\n    <\/script>\n<\/body>\n\n<\/html>\n",
        "css": "\/* ==========================================================================\n   Layout Principal — Curso de IA (Cyber Emerald \/ Dark Tech)\n   Tipografia global: Nunito. Tokens e utilitários de autoria do layout.\n   ========================================================================== *\/\n\n:root {\n    --c2f-abyss: #060e0a;\n    --c2f-deep: #0a1510;\n    --c2f-forest: #0f1f17;\n    --c2f-emerald: #10b981;\n    --c2f-emerald-light: #34d399;\n    --c2f-glow: rgba(52, 211, 153, 0.55);\n}\n\nhtml,\nbody {\n    font-family: 'Nunito', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;\n    font-optical-sizing: auto;\n}\n\nbody {\n    background-color: var(--c2f-abyss);\n}\n\n\/* Grade tecnológica de fundo *\/\n.c2f-grid {\n    background-image:\n        linear-gradient(rgba(16, 185, 129, 0.08) 1px, transparent 1px),\n        linear-gradient(90deg, rgba(16, 185, 129, 0.08) 1px, transparent 1px);\n    background-size: 48px 48px;\n    mask-image: radial-gradient(ellipse at 50% 0%, #000 20%, transparent 75%);\n    -webkit-mask-image: radial-gradient(ellipse at 50% 0%, #000 20%, transparent 75%);\n}\n\n\/* Cabeçalho com vidro ao rolar *\/\n#c2f-header.c2f-header-scrolled {\n    background: rgba(6, 14, 10, 0.82);\n    border-bottom-color: rgba(16, 185, 129, 0.15);\n    backdrop-filter: blur(16px);\n    -webkit-backdrop-filter: blur(16px);\n    box-shadow: 0 10px 40px -20px rgba(16, 185, 129, 0.35);\n}\n\n\/* Links de navegação *\/\n.c2f-navlink {\n    position: relative;\n    display: inline-block;\n    padding: 0.5rem 0.875rem;\n    border-radius: 0.75rem;\n    font-size: 0.875rem;\n    font-weight: 700;\n    color: #cbd5e1;\n    transition: color 0.25s ease, background-color 0.25s ease;\n}\n\n.c2f-navlink::after {\n    content: '';\n    position: absolute;\n    left: 0.875rem;\n    right: 0.875rem;\n    bottom: 0.35rem;\n    height: 2px;\n    border-radius: 2px;\n    background: linear-gradient(90deg, var(--c2f-emerald), var(--c2f-emerald-light));\n    transform: scaleX(0);\n    transform-origin: left;\n    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n    box-shadow: 0 0 10px var(--c2f-glow);\n}\n\n.c2f-navlink:hover {\n    color: #fff;\n}\n\n.c2f-navlink:hover::after {\n    transform: scaleX(1);\n}\n\n.c2f-navlink-mobile {\n    display: block;\n    padding: 0.875rem 1rem;\n    border-radius: 0.75rem;\n    font-size: 1rem;\n    font-weight: 700;\n    color: #e2e8f0;\n    border: 1px solid transparent;\n    transition: all 0.25s ease;\n}\n\n.c2f-navlink-mobile:hover {\n    color: #fff;\n    background: rgba(16, 185, 129, 0.08);\n    border-color: rgba(16, 185, 129, 0.25);\n}\n\n\/* Botão luminoso: brilho varrendo ao passar o mouse *\/\n.c2f-btn-glow {\n    position: relative;\n    overflow: hidden;\n    isolation: isolate;\n}\n\n.c2f-btn-glow::before {\n    content: '';\n    position: absolute;\n    inset: -100% auto -100% -60%;\n    width: 40%;\n    background: linear-gradient(115deg, transparent, rgba(255, 255, 255, 0.55), transparent);\n    transform: skewX(-20deg) translateX(-120%);\n    transition: transform 0.6s ease;\n    z-index: -1;\n}\n\n.c2f-btn-glow:hover::before {\n    transform: skewX(-20deg) translateX(420%);\n}\n\n\/* Rodapé *\/\n.c2f-footer-title {\n    font-size: 0.75rem;\n    font-weight: 800;\n    letter-spacing: 0.18em;\n    text-transform: uppercase;\n    color: #6ee7b7;\n}\n\n.c2f-footer-link {\n    font-size: 0.875rem;\n    font-weight: 600;\n    color: #94a3b8;\n    transition: color 0.25s ease, transform 0.25s ease;\n    display: inline-block;\n}\n\n.c2f-footer-link:hover {\n    color: #a7f3d0;\n    transform: translateX(3px);\n}\n\n.c2f-social {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: 2.5rem;\n    height: 2.5rem;\n    border-radius: 0.75rem;\n    border: 1px solid rgba(255, 255, 255, 0.08);\n    background: rgba(255, 255, 255, 0.04);\n    color: #94a3b8;\n    transition: all 0.3s ease;\n}\n\n.c2f-social:hover {\n    color: #060e0a;\n    background: var(--c2f-emerald-light);\n    border-color: var(--c2f-emerald-light);\n    transform: translateY(-3px) scale(1.05);\n    box-shadow: 0 0 22px var(--c2f-glow);\n}\n\n\/* Revelação progressiva *\/\n.c2f-reveal {\n    opacity: 0;\n    transform: translateY(24px);\n    transition: opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1), transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);\n}\n\n.c2f-reveal.c2f-revealed {\n    opacity: 1;\n    transform: translateY(0);\n}\n\n\/* Flutuação suave dos glows *\/\n@keyframes c2f-float {\n    0%, 100% { transform: translate3d(0, 0, 0); }\n    50% { transform: translate3d(-30px, 40px, 0); }\n}\n\n.c2f-float {\n    animation: c2f-float 14s ease-in-out infinite;\n}\n\n@media (prefers-reduced-motion: reduce) {\n    .c2f-float,\n    .animate-pulse,\n    .animate-ping {\n        animation: none !important;\n    }\n\n    .c2f-reveal {\n        opacity: 1;\n        transform: none;\n        transition: none;\n    }\n}\n",
